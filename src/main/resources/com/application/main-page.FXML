<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.application.ChartController" style="-fx-background-color: #1a1a2e;">
   
   <!-- TOP: Menu Bar + Search Bar -->
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <!-- Menu Bar -->
            <MenuBar style="-fx-background-color: #2c3e50; -fx-text-fill: white;">
               <menus>
                  <Menu mnemonicParsing="false" text="File" style="-fx-text-fill: white;">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#handleImport" text="Load Watchlist" />
                        <MenuItem mnemonicParsing="false" onAction="#handleExport" text="Export Watchlist" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Edit" style="-fx-text-fill: white;">
                     <items>
                        <MenuItem mnemonicParsing="false" text="Delete Selected" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Help" style="-fx-text-fill: white;">
                     <items>
                        <MenuItem mnemonicParsing="false" text="About" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            
            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #2c3e50; -fx-border-color: #3d566e; -fx-border-width: 0 0 1 0;">
               <children>
                  <TextField fx:id="searchTextField" promptText="Search symbol..." style="-fx-background-radius: 20; -fx-background-color: #3d566e; -fx-text-fill: white; -fx-prompt-text-fill: #8a9baa; -fx-border-radius: 20; -fx-border-color: #4a6a8a; -fx-padding: 5 15 5 15;" prefHeight="30.0">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </TextField>
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonPressed" text="🔍" style="-fx-background-radius: 20; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" prefHeight="30.0" prefWidth="35.0" />
                  <Label text="Add Indicator:" textFill="#8a9baa" style="-fx-font-size: 12px; -fx-font-weight: bold;">
                     <HBox.margin>
                        <Insets left="15.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="indicatorComboBox" prefWidth="120.0" style="-fx-background-radius: 15; -fx-background-color: #3d566e; -fx-text-fill: white; -fx-border-radius: 2; -fx-border-color: #4a6a8a;" />
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <!-- CENTER: Chart -->
   <center>
      <StackPane fx:id="chartContainer" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: #0f0f1a;" BorderPane.alignment="CENTER" />
   </center>
   
   <!-- LEFT: Toolbar -->
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="45.0" spacing="5.0" style="-fx-background-color: #1a1a2e; -fx-border-color: #2c3e50; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cursorButton" mnemonicParsing="false" onAction="#cursorButtonPressed" prefHeight="35.0" prefWidth="35.0" text="✋" style="-fx-background-radius: 10; -fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" />
            <Button fx:id="zoomButton" mnemonicParsing="false" onAction="#zoomButtonPressed" prefHeight="35.0" prefWidth="35.0" text="🔍" style="-fx-background-radius: 10; -fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" />
            <Button fx:id="indicatorsButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" text="📊" style="-fx-background-radius: 10; -fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" />
            <Separator style="-fx-background-color: #2c3e50;" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" text="➕" style="-fx-background-radius: 10; -fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" text="📈" style="-fx-background-radius: 10; -fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" />
         </children>
         <padding>
            <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </left>
   
   <!-- RIGHT: Watchlist -->
   <right>
      <ScrollPane fitToHeight="true" fitToWidth="true" prefWidth="220.0" style="-fx-background-color: #1a1a2e; -fx-border-color: #2c3e50; -fx-border-width: 0 0 0 1;" styleClass="custom-scroll-pane" stylesheets="@styles.css" BorderPane.alignment="CENTER">
         <content>
            <VBox maxWidth="220.0" minWidth="220.0" prefWidth="220.0" style="-fx-background-color: #1a1a2e;">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #2c3e50;">
                     <children>
                        <Label alignment="CENTER" text="📋 Watchlist" textFill="white">
                           <font>
                              <Font size="16.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                        </Label>
                        <Button fx:id="addToWatchlistButton" mnemonicParsing="false" onAction="#addToWatchlist" text="➕" style="-fx-background-radius: 15; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" prefHeight="25.0" prefWidth="30.0" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <TableView fx:id="watchlistTable" style="-fx-background-color: #1a1a2e; -fx-table-cell-border-color: #2c3e50; -fx-border-color: #2c3e50; -fx-border-width: 0 0 1 0;">
                    <columns>
                      <TableColumn fx:id="companyColumn" maxWidth="120.0" minWidth="100.0" prefWidth="110.0" text="Company" style="-fx-text-fill: white; -fx-background-color: #2c3e50; -fx-font-weight: bold;" />
                      <TableColumn fx:id="symbolColumn" maxWidth="100.0" minWidth="80.0" prefWidth="90.0" text="Symbol" style="-fx-text-fill: white; -fx-background-color: #2c3e50; -fx-font-weight: bold;" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </right>
   
</BorderPane>